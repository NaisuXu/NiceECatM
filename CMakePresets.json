{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {"name": "windows-mingw-release", "displayName": "Windows x64 / MinGW release", "generator": "MinGW Makefiles", "binaryDir": "${sourceDir}/build/windows-mingw-release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "linux-release", "displayName": "Linux native CPU release", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build/linux-release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}}
  ],
  "buildPresets": [
    {"name": "windows-mingw-release", "configurePreset": "windows-mingw-release"},
    {"name": "linux-release", "configurePreset": "linux-release"}
  ],
  "testPresets": [
    {"name": "windows-mingw-release", "configurePreset": "windows-mingw-release", "output": {"outputOnFailure": true}},
    {"name": "linux-release", "configurePreset": "linux-release", "output": {"outputOnFailure": true}}
  ]
}
