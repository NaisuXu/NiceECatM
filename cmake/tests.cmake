include(CTest)
if(NICEECATM_BUILD_TESTS)
  add_executable(niceecatm_core_tests tests/core_tests.cpp)
  target_link_libraries(niceecatm_core_tests PRIVATE niceecatm_core)
  add_test(NAME core COMMAND niceecatm_core_tests)
  add_executable(niceecatm_controller_tests tests/controller_tests.cpp)
  target_link_libraries(niceecatm_controller_tests PRIVATE niceecatm_core)
  add_test(NAME controller COMMAND niceecatm_controller_tests)
  add_executable(niceecatm_script_bridge_tests tests/script_bridge_tests.cpp)
  target_link_libraries(niceecatm_script_bridge_tests PRIVATE niceecatm_core)
  add_test(NAME script_bridge COMMAND niceecatm_script_bridge_tests)
  add_executable(niceecatm_esi_tests tests/esi_tests.cpp)
  target_link_libraries(niceecatm_esi_tests PRIVATE niceecatm_core)
  target_compile_definitions(niceecatm_esi_tests PRIVATE NICEECATM_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
  add_test(NAME esi_catalog COMMAND niceecatm_esi_tests)
  add_executable(niceecatm_pdo_layout_tests tests/pdo_layout_tests.cpp)
  target_link_libraries(niceecatm_pdo_layout_tests PRIVATE niceecatm_core)
  add_test(NAME pdo_layout COMMAND niceecatm_pdo_layout_tests)
  add_executable(niceecatm_script_runtime_tests tests/script_runtime_tests.cpp)
  target_link_libraries(niceecatm_script_runtime_tests PRIVATE niceecatm_core)
  add_test(NAME script_runtime COMMAND niceecatm_script_runtime_tests)
  # Exercise the production cyclic state monitor against mocked AL replies;
  # link no SOEM transport or capture driver into this fault-injection test.
  add_executable(niceecatm_cyclic_state_poll_tests tests/cyclic_state_poll_tests.cpp)
  get_target_property(soem_headers soem INTERFACE_INCLUDE_DIRECTORIES)
  target_include_directories(niceecatm_cyclic_state_poll_tests PRIVATE "${PROJECT_SOURCE_DIR}/src" ${soem_headers})
  add_test(NAME cyclic_state_poll COMMAND niceecatm_cyclic_state_poll_tests)
  if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang" AND NOT MSVC)
    add_executable(niceecatm_sdoinfo_tests tests/soem_sdoinfo_tests.c)
    target_include_directories(niceecatm_sdoinfo_tests PRIVATE ${soem_headers} "${NICEECATM_SOEM_PATCHED_SOURCE_DIR}")
    target_compile_options(niceecatm_sdoinfo_tests PRIVATE -ffunction-sections -fdata-sections)
    target_link_options(niceecatm_sdoinfo_tests PRIVATE -Wl,--gc-sections)
    add_test(NAME soem_sdo_information COMMAND niceecatm_sdoinfo_tests)
    add_executable(niceecatm_dictionary_tests tests/sdo_dictionary_tests.cpp src/model/pdo.cpp)
    target_include_directories(niceecatm_dictionary_tests PRIVATE "${PROJECT_SOURCE_DIR}/src" ${soem_headers})
    add_test(NAME sdo_dictionary COMMAND niceecatm_dictionary_tests)
    add_executable(niceecatm_sdo_tests tests/soem_sdo_tests.c)
    get_target_property(soem_headers soem INTERFACE_INCLUDE_DIRECTORIES)
    target_include_directories(niceecatm_sdo_tests PRIVATE ${soem_headers} "${NICEECATM_SOEM_PATCHED_SOURCE_DIR}")
    target_compile_options(niceecatm_sdo_tests PRIVATE -ffunction-sections -fdata-sections)
    target_link_options(niceecatm_sdo_tests PRIVATE -Wl,--gc-sections)
    add_test(NAME soem_segmented_sdo COMMAND niceecatm_sdo_tests)
    if(MINGW)
      target_link_options(niceecatm_sdo_tests PRIVATE -static)
      target_link_options(niceecatm_sdoinfo_tests PRIVATE -static)
      target_link_options(niceecatm_dictionary_tests PRIVATE -static -static-libgcc -static-libstdc++)
    endif()
  endif()
  if(MINGW)
    target_link_options(niceecatm_core_tests PRIVATE -static -static-libgcc -static-libstdc++)
    target_link_options(niceecatm_controller_tests PRIVATE -static -static-libgcc -static-libstdc++)
    target_link_options(niceecatm_script_bridge_tests PRIVATE -static -static-libgcc -static-libstdc++)
    target_link_options(niceecatm_esi_tests PRIVATE -static -static-libgcc -static-libstdc++)
    target_link_options(niceecatm_pdo_layout_tests PRIVATE -static -static-libgcc -static-libstdc++)
    target_link_options(niceecatm_script_runtime_tests PRIVATE -static -static-libgcc -static-libstdc++)
    target_link_options(niceecatm_cyclic_state_poll_tests PRIVATE -static -static-libgcc -static-libstdc++)
  endif()
endif()
